# API de la nube del plan Full. Todo pasa por index.php; la carpeta datos/ (respaldos) nunca se sirve.
Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  # El dominio anterior quedó cerrado: la nube vive solo en facmit.com.
  RewriteCond %{HTTP_HOST} (^|\.)mecanicatoapantavelez\.com$ [NC]
  RewriteRule ^(.*)$ https://facmit.com/licencias/nube/$1 [R=301,L,QSA]
  RewriteRule ^datos(/|$) - [F,L]
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^api/(.*)$ index.php?r=$1 [QSA,L]
</IfModule>
