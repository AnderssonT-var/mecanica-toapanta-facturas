# App web del plan Full. Solo index.php y assets/ son públicos.
Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  # La app web vive solo en facmit.com (el dominio anterior quedó cerrado: todo se envía allí).
  RewriteCond %{HTTP_HOST} (^|\.)mecanicatoapantavelez\.com$ [NC]
  RewriteRule ^(.*)$ https://facmit.com/licencias/app/$1 [R=301,L,QSA]
  RewriteRule ^(lib|vistas)(/|$) - [F,L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
