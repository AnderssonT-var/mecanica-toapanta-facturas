# Portal de licencias: protege archivos internos y fuerza HTTPS.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule ^(lib|privado)(/|$) - [F,L]
  RewriteRule (^|/)\.(git|github|gitignore) - [F,L]
</IfModule>

<FilesMatch "^(config\.php|llave-incluida\.php|.*\.sqlite|.*\.md|\..+)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
