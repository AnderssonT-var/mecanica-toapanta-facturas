# Portal de licencias: protege archivos internos y fuerza HTTPS.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # El portal vive solo en facmit.com. El dominio anterior (mecanicatoapantavelez.com) quedó cerrado el 17/11/2026:
  # todo lo que llegue a él se envía de forma permanente al dominio nuevo (los programas desde 0.12 ya usan facmit.com
  # y corrigen solos una dirección vieja guardada).
  RewriteCond %{HTTP_HOST} (^|\.)mecanicatoapantavelez\.com$ [NC]
  RewriteRule ^(.*)$ https://facmit.com/licencias/$1 [R=301,L,QSA]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule ^(lib|privado)(/|$) - [F,L]
  RewriteRule (^|/)\.(git|github|gitignore) - [F,L]
</IfModule>

<FilesMatch "^(config\.php|llave-incluida\.php|.*\.sqlite|.*\.md|\..+)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
