# Portal de licencias: protege archivos internos y fuerza HTTPS.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # El portal vive en facmit.com. En el dominio anterior siguen funcionando api.php y nube/ (programas ya
  # instalados); las páginas y las descargas de actualizaciones se envían al dominio nuevo.
  RewriteCond %{HTTP_HOST} (^|\.)mecanicatoapantavelez\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{REQUEST_URI} !/api\.php$
  RewriteCond %{REQUEST_URI} !/nube/
  RewriteRule ^(.*)$ https://facmit.com/licencias/$1 [R=302,L,QSA]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule ^(lib|privado)(/|$) - [F,L]
  RewriteRule (^|/)\.(git|github|gitignore) - [F,L]
</IfModule>

<FilesMatch "^(config\.php|llave-incluida\.php|.*\.sqlite|.*\.md|\..+)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
